<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
    <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
    <PropertyGroup>
        <TimeStampServer>http://timestamp.digicert.com</TimeStampServer>
        <SignCommandSHA1>signtool sign /f "$(SIGN_CERTIFICATE)" /v /sha1 $(SIGN_SHA1) /p $(SIGN_PASSWORD) /tr $(TimeStampServer) /td sha1 /fd sha1</SignCommandSHA1>
        <SignCommandSHA256>signtool sign /f "$(SIGN_CERTIFICATE)" /v /sha1 $(SIGN_SHA1) /p $(SIGN_PASSWORD) /tr $(TimeStampServer) /td sha256 /fd sha256 /as</SignCommandSHA256>
        <Configuration Condition="'$(Configuration)' == ''">Debug</Configuration>
        <Platform Condition="'$(Platform)' == ''">Win32</Platform>
        <ConfigurationName Condition="'$(Platform)|$(Configuration)' == 'Win32|Debug'">debug-VC-WIN32</ConfigurationName>
        <ConfigurationName Condition="'$(Platform)|$(Configuration)' == 'Win32|Release'">VC-WIN32</ConfigurationName>
        <ConfigurationName Condition="'$(Platform)|$(Configuration)' == 'x64|Debug'">debug-VC-WIN64A</ConfigurationName>
        <ConfigurationName Condition="'$(Platform)|$(Configuration)' == 'x64|Release'">VC-WIN64A</ConfigurationName>
        <PlatformName Condition="'$(Platform)' == 'Win32'">x86</PlatformName>
        <PlatformName Condition="'$(Platform)' == 'x64'">amd64</PlatformName>
        <LibSuffix Condition="'$(Platform)' == 'Win32'">-1_1</LibSuffix>
        <LibSuffix Condition="'$(Platform)' == 'x64'">-1_1-x64</LibSuffix>
    </PropertyGroup>

    <Target Name="Build">
        <RemoveDir  Directories="$(InstallPrefix)"/>
        <Exec Command="git clean -dxf --exclude msbuild" WorkingDirectory="$(MSBuildThisFileDirectory)\.."/>
        <Exec Command="perl Configure $(ConfigurationName) no-asm --prefix=$(InstallPrefix) --openssldir=C:\ProgramData\ZeroC\openssl-$(OpenSSLVersion) enable-static-engine" WorkingDirectory="$(MSBuildThisFileDirectory)\.."/>
        <Exec Command="nmake" WorkingDirectory="$(MSBuildThisFileDirectory)\.."/>
        <Exec Command="nmake install" WorkingDirectory="$(MSBuildThisFileDirectory)\.."/>
    </Target>

    <Target Name="SignPackage" AfterTargets="Build" Condition="Exists('$(SIGN_CERTIFICATE)')">
        <Message Text="Signing libcrypto.dll" />
        <Exec Command="$(SignCommandSHA1) $(InstallPrefix)\bin\libcrypto$(LibSuffix).dll" EchoOff="yes"/>
        <Exec Command="$(SignCommandSHA256) $(InstallPrefix)\bin\libcrypto$(LibSuffix).dll" EchoOff="yes"/>
        <Message Text="Signing openssl.exe" />
        <Exec Command="$(SignCommandSHA1) $(InstallPrefix)\bin\openssl.exe" EchoOff="yes"/>
        <Exec Command="$(SignCommandSHA256) $(InstallPrefix)\bin\openssl.exe" EchoOff="yes"/>
        <Message Text="Signing libssl.dll" />
        <Exec Command="$(SignCommandSHA1) $(InstallPrefix)\bin\libssl$(LibSuffix).dll" EchoOff="yes"/>
        <Exec Command="$(SignCommandSHA256) $(InstallPrefix)\bin\libssl$(LibSuffix).dll" EchoOff="yes"/>
    </Target>
</Project>
